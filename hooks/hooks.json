{
  "description": "sdd plugin gates: a worker on an sdd/* branch cannot stop without a recorded Verify run and a clean tree; a worktree with uncommitted or unpushed work cannot be removed.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/verify-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/verify-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-guard.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
