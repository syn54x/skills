{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "bash scripts/verify-gate.sh",
        "timeout": 20
      }
    ],
    "subagentStop": [
      {
        "command": "bash scripts/verify-gate.sh",
        "timeout": 20
      }
